# IMPACTA — variáveis locais de ambiente (copiar para .env; nunca publicar)
PORT=5000
NODE_ENV=development

# Conta de runtime com privilégios limitados (impacta_app)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=impacta_local
DB_USER=impacta_app
DB_PASSWORD=definir_localmente
DB_SSL=false

# Conta separada para migrações (impacta_migrator); nunca usar no servidor da API
MIGRATION_DB_USER=impacta_migrator
MIGRATION_DB_PASSWORD=definir_localmente
MIGRATION_DB_SSL=false

# Pool reservado à criação de contas e autenticação
AUTH_DB_USER=impacta_auth
AUTH_DB_PASSWORD=definir_localmente
AUTH_DB_SSL=false

# Worker isolado que inspecciona uploads e controla o estado dos ficheiros
MEDIA_DB_USER=impacta_media
MEDIA_DB_PASSWORD=definir_localmente
MEDIA_DB_SSL=false


# Modelo apenas. Configure estes valores no gestor de segredos do alojamento.
# Nunca copie passwords reais para este ficheiro nem o envie para o Git.
NODE_ENV=production
PORT=5000

DB_HOST=host-da-base-de-dados-de-producao
DB_PORT=5432
DB_NAME=impacta_production
DB_USER=impacta_app
DB_PASSWORD=fornecida-pelo-gestor-de-segredos
DB_SSL=true

# Conta temporária e exclusiva do processo de migrations/bootstrap.
MIGRATION_DB_USER=impacta_migrator
MIGRATION_DB_PASSWORD=fornecida-pelo-gestor-de-segredos
MIGRATION_DB_SSL=true
# Só para o primeiro bootstrap administrativo, depois da revisão do destino:
# IMPACTA_BOOTSTRAP_CONFIRM=IMPACTA_PRODUCTION

AUTH_DB_USER=impacta_auth
AUTH_DB_PASSWORD=fornecida-pelo-gestor-de-segredos
AUTH_DB_SSL=true

MEDIA_DB_USER=impacta_media
MEDIA_DB_PASSWORD=fornecida-pelo-gestor-de-segredos
MEDIA_DB_SSL=true
